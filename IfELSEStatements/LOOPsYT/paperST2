#include <stdio.h>
int main(){
    int n,m,sum=0,i=0;
    scanf("%d",&n);
    while(i<n){
        scanf("%d",&m);
        if(m<0){
            break;
        }
        else if(m>0){
            sum=sum+m;
        }
        i++;
    }
    printf("%d",sum);
}
